# Database
DATABASE_URL=postgresql+asyncpg://benchpro:benchpro_dev@localhost:5432/benchpro_results

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# OIDC/SSO (optional for local dev - uses mock auth when not set)
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=benchpro-results
# OIDC_CLIENT_SECRET=your-client-secret

# Rate Limiting
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

