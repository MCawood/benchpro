#!/bin/bash
# Local benchmark run script for {{ job.name }}

# Job Information
echo "Job Name: {{ job.name }}"
echo "Start Time: $(date)"

# Get current directory
CURRENT_DIR=$(pwd)

# Run the benchmark
echo "Running benchmark: {{ benchmark.name }}"
${CURRENT_DIR}/{{ workspace.build_dir }}/{{ benchmark.application }} {{ benchmark.input_params }}

# Save output to results directory
echo "Results saved to: {{ workspace.results_dir }}"

echo "End Time: $(date)"
echo "Benchmark run completed successfully" 