#!/bin/bash
#SBATCH --job-name={{ job.name }}
#SBATCH --output={{ workspace.logs_dir }}/{{ job.name }}_%j.out
#SBATCH --error={{ workspace.logs_dir }}/{{ job.name }}_%j.err
#SBATCH --time={{ scheduler.time_limit }}
#SBATCH --nodes={{ scheduler.nodes }}
#SBATCH --ntasks-per-node={{ scheduler.tasks_per_node }}
{% if scheduler.queue is defined %}
#SBATCH --partition={{ scheduler.queue }}
{% endif %}
{% if scheduler.account is defined %}
#SBATCH --account={{ scheduler.account }}
{% endif %}

# Job Information
echo "Job ID: $SLURM_JOB_ID"
echo "Job Name: {{ job.name }}"
echo "Nodes: $SLURM_JOB_NODELIST"
echo "Start Time: $(date)"

# Get the current directory
CURRENT_DIR=$(pwd)

# Load modules
{% if environment is defined and environment.modules is defined %}
{% for module in environment.modules %}
module load {{ module }}
{% endfor %}
{% endif %}

# Change to source directory
cd {{ application.source_dir }}

# Build the application
echo "Building application: {{ application.name }}"
{{ application.build_script }}

# Copy the binary to the build directory (using absolute path)
mkdir -p ${CURRENT_DIR}/{{ workspace.build_dir }}
cp {{ application.output_binary }} ${CURRENT_DIR}/{{ workspace.build_dir }}/

echo "End Time: $(date)"
echo "Application build completed successfully" 