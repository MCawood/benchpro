#!/bin/bash
# Hello World benchmark run script

# Job Information
echo "Job Name: {{ job.name }}"
echo "Start Time: $(date)"

# Load any required modules
{% if environment and environment.module_paths %}
echo "Adding module paths..."
{% for module_path in environment.module_paths %}
module use {{ module_path }}
{% endfor %}
{% endif %}

{% if environment and environment.modules %}
echo "Loading modules..."
{% for module in environment.modules %}
module load {{ module }}
{% endfor %}
{% endif %}

# Set any environment variables
{% if environment and environment.variables %}
echo "Setting environment variables..."
{% for key, value in environment.variables.items() %}
export {{ key }}="{{ value }}"
{% endfor %}
{% endif %}

# Create results directory
mkdir -p {{ workspace.output_dir }}

# Run the application
echo "Running executable: {{ run.executable }}"

# Run with timing
echo "Starting benchmark run..."
time {{ run.executable }} {{ run.arguments }}

# Copy results to results directory
echo "Benchmark completed. Saving results..."

# Record completion
echo "End Time: $(date)"
echo "Benchmark run completed successfully" 