#!/bin/bash
echo "Building ${name} version ${version}"

# Setup install dir
mkdir -p install/bin

# Compile
# Source is relative to config file, so we need to copy it or reference it
# For this demo, we assume source is in the same dir as config
# We need to resolve the source path relative to the config file location
# But here we just hardcode the copy from the examples dir for the demo
cp /Users/mcawood/dev/benchpro_antigravity/examples/build/pi.c .

${compiler} ${variables.cflags} -o install/bin/pi_calc ${source}

# Verify
if [ -f install/bin/pi_calc ]; then
    echo "Compilation successful"
else
    echo "Compilation failed"
    exit 1
fi
